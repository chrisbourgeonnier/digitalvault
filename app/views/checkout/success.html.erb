<div class="container mx-auto p-6">
  <div class="bg-green-50 border-l-4 border-green-500 p-6 mb-6">
    <h1 class="text-3xl font-bold text-green-800 mb-2">Payment Successful! 🎉</h1>
    <p class="text-green-700">Thank you for your purchase!</p>
  </div>

  <% if @order %>
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
      <h2 class="text-2xl font-bold mb-4">Order Summary</h2>

      <div class="mb-4">
        <p class="text-gray-700"><strong>Order ID:</strong> #<%= @order.id %></p>
        <p class="text-gray-700"><strong>Total:</strong> $<%= sprintf("%.2f", @order.total) %></p>
        <p class="text-gray-700"><strong>Status:</strong>
          <span class="px-2 py-1 rounded bg-green-100 text-green-800 font-semibold">
            <%= @order.status.capitalize %>
          </span>
        </p>
      </div>

      <h3 class="text-xl font-bold mb-3 mt-6">Your Digital Downloads</h3>

      <div class="space-y-4">
        <% @order.cart_data.each do |product_id, quantity| %>
          <% product = Product.find_by(id: product_id) %>
          <% if product %>
            <div class="border rounded-lg p-4 bg-gray-50">
              <div class="flex justify-between items-center">
                <div>
                  <h4 class="font-bold text-lg"><%= product.title %></h4>
                  <p class="text-gray-600 text-sm"><%= product.description.truncate(100) %></p>
                  <% if product.digital_file.attached? %>
                    <p class="text-gray-500 text-sm mt-1">
                      File: <%= product.digital_file.filename %>
                      (<%= number_to_human_size(product.digital_file.byte_size) %>)
                    </p>
                  <% end %>
                </div>
                <div class="ml-4">
                  <% if product.digital_file.attached? %>
                    <%= link_to "Download", download_path(product),
                        class: "bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 inline-block text-center font-semibold" %>
                  <% else %>
                    <span class="text-red-500 text-sm">No file available</span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="mt-6">
      <%= link_to "Browse More Products", products_path, class: "bg-gray-500 text-white px-6 py-3 rounded-lg hover:bg-gray-600 inline-block" %>
    </div>
  <% else %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <p>Order not found. Please contact support.</p>
    </div>
  <% end %>
</div>
