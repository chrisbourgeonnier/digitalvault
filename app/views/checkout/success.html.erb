<div class="page-container">
  <% if @order %>
    <!-- Success Header -->
    <div class="card mb-8 text-center bg-green-50 border-l-4 border-green-500">
      <div class="flex justify-center mb-4">
        <svg class="w-16 h-16 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-green-800 mb-2">Payment Successful!</h1>
      <p class="text-green-700">Thank you for your purchase. Your order has been confirmed.</p>
    </div>

    <!-- Order Summary -->
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div class="card">
          <h2 class="text-2xl font-bold mb-4">Order Details</h2>

          <div class="grid grid-cols-2 gap-4 mb-6 pb-6 border-b border-gray-200">
            <div>
              <p class="text-sm text-gray-600 mb-1">Order ID</p>
              <p class="font-semibold">#<%= @order.id %></p>
            </div>
            <div>
              <p class="text-sm text-gray-600 mb-1">Order Date</p>
              <p class="font-semibold"><%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
            </div>
            <div>
              <p class="text-sm text-gray-600 mb-1">Status</p>
              <p><span class="badge badge-green"><%= @order.status.capitalize %></span></p>
            </div>
            <div>
              <p class="text-sm text-gray-600 mb-1">Total Amount</p>
              <p class="text-2xl font-bold text-green-600">$<%= sprintf("%.2f", @order.total) %></p>
            </div>
          </div>

          <h3 class="text-xl font-bold mb-4">Your Digital Downloads</h3>

          <div class="space-y-4">
            <% @order.cart_data.each do |product_id, quantity| %>
              <% product = Product.find_by(id: product_id) %>
              <% if product %>
                <div class="flex gap-4 p-4 bg-gray-50 rounded-lg">
                  <% if product.image.attached? %>
                    <%= image_tag product.image.variant(resize_to_fill: [100, 100]), class: "w-20 h-20 object-cover rounded", alt: product.title %>
                  <% else %>
                    <div class="w-20 h-20 bg-gray-200 rounded flex items-center justify-center flex-shrink-0">
                      <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                    </div>
                  <% end %>

                  <div class="flex-1">
                    <h4 class="font-bold text-lg mb-1"><%= product.title %></h4>
                    <p class="text-gray-600 text-sm mb-2 line-clamp-2"><%= product.description %></p>
                    <% if product.digital_file.attached? %>
                      <p class="text-gray-500 text-xs">
                        <%= product.digital_file.filename %> (<%= number_to_human_size(product.digital_file.byte_size) %>)
                      </p>
                    <% end %>
                  </div>

                  <div class="flex flex-col justify-between items-end">
                    <p class="font-semibold text-gray-700">$<%= sprintf("%.2f", product.price) %></p>
                    <% if product.digital_file.attached? %>
                      <%= link_to "Download", download_path(product), class: "btn btn-primary btn-sm" %>
                    <% else %>
                      <span class="text-red-500 text-xs">No file available</span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="lg:col-span-1">
        <div class="card">
          <h3 class="text-lg font-bold mb-4">What's Next?</h3>

          <div class="space-y-3">
            <%= link_to orders_path, class: "btn btn-primary w-full" do %>
              <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              View All Orders
            <% end %>

            <%= link_to products_path, class: "btn btn-secondary w-full" do %>
              <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
              Continue Shopping
            <% end %>
          </div>

          <div class="mt-6 pt-6 border-t border-gray-200">
            <p class="text-sm text-gray-600">
              <svg class="w-4 h-4 inline text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              You can re-download your files anytime from your order history.
            </p>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Error State -->
    <div class="empty-state">
      <svg class="empty-state-icon text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <h2 class="empty-state-title">Order Not Found</h2>
      <p class="empty-state-text">We couldn't find this order. Please contact support if you need assistance.</p>
      <%= link_to "Go to Orders", orders_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
