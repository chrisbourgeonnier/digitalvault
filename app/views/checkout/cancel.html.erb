<div class="page-container">
  <div class="max-w-2xl mx-auto">
    <div class="card text-center bg-yellow-50 border-l-4 border-yellow-500">
      <div class="flex justify-center mb-4">
        <svg class="w-16 h-16 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>

      <h1 class="text-3xl font-bold text-yellow-800 mb-3">Checkout Cancelled</h1>
      <p class="text-yellow-700 mb-6">Your payment was cancelled. No charges were made to your account.</p>

      <div class="bg-white rounded-lg p-4 mb-6">
        <p class="text-gray-600 text-sm">
          <svg class="w-4 h-4 inline text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Don't worry! Your cart items are still saved and waiting for you.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <%= link_to cart_path, class: "btn btn-primary" do %>
          <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          Return to Cart
        <% end %>

        <%= link_to products_path, class: "btn btn-secondary" do %>
          <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          Continue Shopping
        <% end %>
      </div>
    </div>
  </div>
</div>
