<div class="page-container">
  <div class="max-w-md mx-auto">
    <div class="text-center mb-8">
      <svg class="w-16 h-16 text-blue-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
      </svg>
      <h1 class="text-3xl font-bold mb-2">Forgot Password?</h1>
      <p class="text-gray-600">No worries! We'll send you reset instructions.</p>
    </div>

    <div class="form-container">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-group">
          <%= f.label :email %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input", placeholder: "Enter your email address" %>
        </div>

        <div class="form-actions">
          <%= f.submit "Send Reset Instructions", class: "btn btn-primary btn-lg w-full" %>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <%= link_to "← Back to Sign In", new_session_path(resource_name), class: "text-sm text-blue-600 hover:text-blue-700" %>
      </div>
    </div>
  </div>
</div>
