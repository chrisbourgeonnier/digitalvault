<div class="container mx-auto p-6">
  <div class="mb-6">
    <%= link_to "← Back to My Orders", orders_path, class: "text-blue-500 hover:text-blue-700" %>
  </div>

  <div class="bg-white shadow-lg rounded-lg p-6 mb-6">
    <h1 class="text-3xl font-bold mb-4">Order #<%= @order.id %></h1>

    <div class="grid grid-cols-2 gap-4 mb-6">
      <div>
        <p class="text-gray-600"><strong>Order Date:</strong></p>
        <p class="text-lg"><%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      </div>

      <div>
        <p class="text-gray-600"><strong>Status:</strong></p>
        <p>
          <span class="px-3 py-1 rounded text-lg font-semibold <%= @order.status == 'paid' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
            <%= @order.status.capitalize %>
          </span>
        </p>
      </div>

      <div>
        <p class="text-gray-600"><strong>Total Amount:</strong></p>
        <p class="text-2xl font-bold text-green-600">$<%= sprintf("%.2f", @order.total) %></p>
      </div>

      <div>
        <p class="text-gray-600"><strong>Payment Method:</strong></p>
        <p class="text-lg">Credit Card (Stripe)</p>
      </div>
    </div>
  </div>

  <div class="bg-white shadow-lg rounded-lg p-6">
    <h2 class="text-2xl font-bold mb-4">Order Items</h2>

    <div class="space-y-4">
      <% @order.cart_data.each do |product_id, quantity| %>
        <% product = Product.find_by(id: product_id) %>
        <% if product %>
          <div class="border rounded-lg p-4 bg-gray-50">
            <div class="flex justify-between items-center">
              <div class="flex-1">
                <h3 class="font-bold text-lg"><%= product.title %></h3>
                <p class="text-gray-600 text-sm mb-2"><%= product.description.truncate(150) %></p>

                <% if product.digital_file.attached? %>
                  <p class="text-gray-500 text-sm">
                    <strong>File:</strong> <%= product.digital_file.filename %>
                    (<%= number_to_human_size(product.digital_file.byte_size) %>)
                  </p>
                <% end %>

                <p class="text-gray-700 mt-2">
                  <strong>Price:</strong> $<%= sprintf("%.2f", product.price) %>
                </p>
              </div>

              <div class="ml-4">
                <% if @order.status == "paid" && product.digital_file.attached? %>
                  <%= link_to "Download", download_path(product),
                      class: "bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 inline-block text-center font-semibold" %>
                <% elsif @order.status != "paid" %>
                  <span class="text-yellow-600 text-sm font-semibold">Payment pending</span>
                <% else %>
                  <span class="text-red-500 text-sm">No file available</span>
                <% end %>
              </div>
            </div>
          </div>
        <% else %>
          <div class="border rounded-lg p-4 bg-red-50">
            <p class="text-red-600">Product no longer available</p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
