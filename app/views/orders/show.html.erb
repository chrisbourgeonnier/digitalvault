<div class="page-container">
  <!-- Back navigation -->
  <%= link_to orders_path, class: "nav-link" do %>
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
    Back to My Orders
  <% end %>

  <div class="grid lg:grid-cols-3 gap-8">
    <!-- Order Details -->
    <div class="lg:col-span-2">
      <div class="card mb-6">
        <div class="flex items-center justify-between mb-6">
          <h1 class="text-3xl font-bold">Order #<%= @order.id %></h1>
          <% if @order.status == "paid" %>
            <span class="badge badge-green text-base px-4 py-2">
              <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Paid
            </span>
          <% elsif @order.status == "pending" %>
            <span class="badge badge-yellow text-base px-4 py-2">
              <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Pending
            </span>
          <% else %>
            <span class="badge badge-red text-base px-4 py-2"><%= @order.status.capitalize %></span>
          <% end %>
        </div>

        <div class="grid grid-cols-2 gap-6 pb-6 border-b border-gray-200">
          <div>
            <p class="text-sm text-gray-600 mb-1">Order Date</p>
            <p class="font-semibold text-lg"><%= @order.created_at.strftime("%B %d, %Y") %></p>
            <p class="text-gray-500 text-sm"><%= @order.created_at.strftime("%I:%M %p") %></p>
          </div>
          <div>
            <p class="text-sm text-gray-600 mb-1">Total Amount</p>
            <p class="text-3xl font-bold text-green-600">$<%= sprintf("%.2f", @order.total) %></p>
          </div>
        </div>
      </div>

      <!-- Order Items -->
      <div class="card">
        <h2 class="text-2xl font-bold mb-6">Order Items</h2>

        <div class="space-y-4">
          <% @order.cart_data.each do |product_id, quantity| %>
            <% product = Product.find_by(id: product_id) %>
            <% if product %>
              <div class="flex gap-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
                <!-- Product Image -->
                <% if product.image.attached? %>
                  <%= image_tag product.image.variant(resize_to_fill: [120, 120]), class: "w-24 h-24 object-cover rounded flex-shrink-0", alt: product.title %>
                <% else %>
                  <div class="w-24 h-24 bg-gray-200 rounded flex items-center justify-center flex-shrink-0">
                    <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                <% end %>

                <!-- Product Details -->
                <div class="flex-1">
                  <h3 class="font-bold text-lg mb-2"><%= product.title %></h3>
                  <p class="text-gray-600 text-sm mb-3 line-clamp-2"><%= product.description %></p>

                  <% if product.digital_file.attached? %>
                    <div class="flex items-center text-sm text-gray-500 mb-2">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      <%= product.digital_file.filename %> (<%= number_to_human_size(product.digital_file.byte_size) %>)
                    </div>
                  <% end %>

                  <p class="font-semibold text-gray-700">
                    $<%= sprintf("%.2f", product.price) %>
                    <span class="text-gray-500 font-normal">× <%= quantity %></span>
                  </p>
                </div>

                <!-- Download Button -->
                <div class="flex flex-col justify-between items-end">
                  <p class="text-lg font-bold text-gray-900">$<%= sprintf("%.2f", product.price * quantity) %></p>
                  <% if @order.status == "paid" && product.digital_file.attached? %>
                    <%= link_to download_path(product), class: "btn btn-success btn-sm" do %>
                      <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                      </svg>
                      Download
                    <% end %>
                  <% elsif @order.status != "paid" %>
                    <span class="text-xs text-yellow-600">Payment pending</span>
                  <% else %>
                    <span class="text-xs text-red-500">File unavailable</span>
                  <% end %>
                </div>
              </div>
            <% else %>
              <div class="p-4 bg-red-50 rounded-lg border border-red-200">
                <p class="text-red-600 text-sm font-semibold">Product no longer available</p>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <div class="card sticky top-4">
        <h3 class="text-lg font-bold mb-4">Order Summary</h3>

        <div class="space-y-3 pb-4 border-b border-gray-200">
          <div class="flex justify-between text-gray-600">
            <span>Items</span>
            <span><%= pluralize(@order.cart_data.keys.count, "item") %></span>
          </div>
          <div class="flex justify-between text-gray-600">
            <span>Subtotal</span>
            <span>$<%= sprintf("%.2f", @order.total) %></span>
          </div>
          <div class="flex justify-between text-gray-600">
            <span>Shipping</span>
            <span class="text-green-600 font-semibold">Free</span>
          </div>
        </div>

        <div class="flex justify-between text-xl font-bold mt-4 mb-6">
          <span>Total</span>
          <span class="text-green-600">$<%= sprintf("%.2f", @order.total) %></span>
        </div>

        <% if @order.status == "paid" %>
          <div class="bg-green-50 rounded-lg p-4 text-center">
            <svg class="w-8 h-8 text-green-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p class="text-sm text-green-800 font-semibold">Payment Complete</p>
            <p class="text-xs text-green-600 mt-1">All files are ready to download</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
