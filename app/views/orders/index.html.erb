<div class="page-container">
  <div class="page-header">
    <h1>My Orders</h1>
    <%= link_to "Browse Products", products_path, class: "btn btn-secondary" %>
  </div>

  <% if @orders.any? %>
    <div class="space-y-4">
      <% @orders.each do |order| %>
        <div class="card hover:shadow-lg transition">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <!-- Order Info -->
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <h2 class="text-xl font-bold">Order #<%= order.id %></h2>
                <% if order.status == "paid" %>
                  <span class="badge badge-green">
                    <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Paid
                  </span>
                <% elsif order.status == "pending" %>
                  <span class="badge badge-yellow">
                    <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Pending
                  </span>
                <% elsif order.status == "failed" %>
                  <span class="badge badge-red">
                    <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    Failed
                  </span>
                <% else %>
                  <span class="badge badge-gray"><%= order.status.capitalize %></span>
                <% end %>
              </div>

              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                <div>
                  <p class="text-gray-600 mb-1">Date</p>
                  <p class="font-semibold"><%= order.created_at.strftime("%b %d, %Y") %></p>
                </div>
                <div>
                  <p class="text-gray-600 mb-1">Items</p>
                  <p class="font-semibold"><%= pluralize(order.cart_data.keys.count, "item") %></p>
                </div>
                <div>
                  <p class="text-gray-600 mb-1">Total</p>
                  <p class="text-lg font-bold text-green-600">$<%= sprintf("%.2f", order.total) %></p>
                </div>
                <div>
                  <p class="text-gray-600 mb-1">Time</p>
                  <p class="font-semibold"><%= order.created_at.strftime("%I:%M %p") %></p>
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex md:flex-col gap-2">
              <%= link_to "View Details", order_path(order), class: "btn btn-primary" %>
              <% if order.status == "paid" %>
                <span class="text-xs text-gray-500 text-center">Downloads available</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Summary Stats -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="card text-center bg-blue-50">
        <p class="text-3xl font-bold text-blue-600"><%= @orders.count %></p>
        <p class="text-gray-600 text-sm">Total Orders</p>
      </div>
      <div class="card text-center bg-green-50">
        <p class="text-3xl font-bold text-green-600"><%= @orders.where(status: "paid").count %></p>
        <p class="text-gray-600 text-sm">Completed</p>
      </div>
      <div class="card text-center bg-purple-50">
        <p class="text-3xl font-bold text-purple-600">$<%= sprintf("%.2f", @orders.where(status: "paid").sum(:total)) %></p>
        <p class="text-gray-600 text-sm">Total Spent</p>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="empty-state">
      <svg class="empty-state-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <h2 class="empty-state-title">No orders yet</h2>
      <p class="empty-state-text">When you make a purchase, your order history will appear here.</p>
      <%= link_to "Start Shopping", products_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
