<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Digitalvault" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Digitalvault">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="bg-gray-800 text-white p-4">
      <div class="container mx-auto flex justify-between items-center">
        <div class="flex space-x-4">
          <%= link_to "DigitalVault", products_path, class: "font-bold text-xl" %>
          <%= link_to "Products", products_path, class: "hover:text-gray-300" %>
          <% if user_signed_in? %>
            <%= link_to "My Orders", orders_path, class: "hover:text-gray-300" %>
          <% end %>
        </div>

        <div class="flex space-x-4 items-center">
          <%= link_to "Cart (#{cart_item_count})", cart_path, class: "hover:text-gray-300" %>

          <% if user_signed_in? %>
            <span class="text-sm"><%= current_user.email %></span>
            <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "hover:text-gray-300" %>
          <% else %>
            <%= link_to "Sign In", new_user_session_path, class: "hover:text-gray-300" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "hover:text-gray-300" %>
          <% end %>
        </div>
      </div>
    </nav>


    <% if notice %>
      <p class="notice bg-green-100 text-green-800 p-4"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="alert bg-red-100 text-red-800 p-4"><%= alert %></p>
    <% end %>

    <main class="container mx-auto mt-8 px-5">
      <%= yield %>
    </main>
  </body>
</html>
