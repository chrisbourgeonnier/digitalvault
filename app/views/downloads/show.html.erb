<div class="page-container">
  <div class="max-w-2xl mx-auto text-center">
    <div class="card bg-blue-50 border-l-4 border-blue-500">
      <svg class="w-16 h-16 text-blue-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
      <h1 class="text-3xl font-bold text-blue-800 mb-3">Preparing Your Download</h1>
      <p class="text-blue-700">Your file download should start automatically. If it doesn't, click the button below.</p>

      <div class="mt-6">
        <%= link_to "Download Now", "#", class: "btn btn-primary btn-lg" %>
      </div>
    </div>

    <div class="mt-8">
      <%= link_to "← Back to Orders", orders_path, class: "text-blue-600 hover:text-blue-700" %>
    </div>
  </div>
</div>
