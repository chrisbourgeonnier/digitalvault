<div class="products-index">
  <h1>Products</h1>

  <% if @products.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Price</th>
          <th>Seller</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><%= link_to product.title, product %></td>
            <td>$<%= product.price %></td>
            <td><%= product.user.email %></td>
            <td><%= button_to 'Add to Cart', add_item_to_cart_path(product.id), method: :post, class: 'btn-sm' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No products yet.</p>
  <% end %>

  <%= link_to 'New Product', new_product_path %>
</div>
