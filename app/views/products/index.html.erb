<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Products</h1>
    <% if user_signed_in? %>
      <%= link_to "New Product", new_product_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <!-- Search and Filter Form -->
  <div class="mb-8">
    <%= form_with url: products_path, method: :get, local: true, class: "bg-white shadow-md rounded-lg p-6" do |f| %>
      <div class="grid md:grid-cols-3 gap-4">
        <!-- Search by keyword -->
        <div>
          <%= f.label :search, "Search", class: "block font-semibold mb-2" %>
          <%= f.text_field :search, value: params[:search], placeholder: "Search by title or description...", class: "input w-full" %>
        </div>

        <!-- Price range -->
        <div>
          <%= f.label :min_price, "Min Price", class: "block font-semibold mb-2" %>
          <%= f.number_field :min_price, value: params[:min_price], step: 0.01, min: 0, placeholder: "0.00", class: "input w-full" %>
        </div>

        <div>
          <%= f.label :max_price, "Max Price", class: "block font-semibold mb-2" %>
          <%= f.number_field :max_price, value: params[:max_price], step: 0.01, min: 0, placeholder: "Any", class: "input w-full" %>
        </div>
      </div>

      <!-- Sort options -->
      <div class="mt-4 flex gap-4 items-end">
        <div class="flex-1">
          <%= f.label :sort, "Sort By", class: "block font-semibold mb-2" %>
          <%= f.select :sort,
              options_for_select([
                ["Newest First", "newest"],
                ["Oldest First", "oldest"],
                ["Price: Low to High", "price_asc"],
                ["Price: High to Low", "price_desc"]
              ], params[:sort]),
              {},
              class: "input w-full" %>
        </div>

        <div class="flex gap-2">
          <%= f.submit "Apply Filters", class: "btn btn-primary" %>
          <%= link_to "Clear", products_path, class: "btn btn-secondary" %>
        </div>
      </div>
    <% end %>

      <!-- Category Filter -->
      <div class="mb-6">
        <h3 class="text-lg font-semibold mb-3">Filter by Category</h3>
        <div class="flex flex-wrap gap-2">
          <%= link_to "All Products", products_path(search: params[:search], min_price: params[:min_price], max_price: params[:max_price], sort: params[:sort]),
                      class: "px-4 py-2 rounded-lg transition #{params[:category_id].blank? ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>

          <% Category.ordered.each do |category| %>
            <%= link_to category.name, products_path(category_id: category.id, search: params[:search], min_price: params[:min_price], max_price: params[:max_price], sort: params[:sort]),
                        class: "px-4 py-2 rounded-lg transition #{params[:category_id].to_i == category.id ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>
          <% end %>
        </div>

        <% if @category.present? %>
          <p class="text-sm text-gray-600 mt-2">
            Showing products in <strong><%= @category.name %></strong>
          </p>
        <% end %>
      </div>

  </div>

  <!-- Results count -->
  <% if params[:search].present? || params[:min_price].present? || params[:max_price].present? %>
    <div class="mb-4 text-gray-600">
      Found <%= pluralize(@products.count, "product") %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @products.each do |product| %>
      <div class="card hover:shadow-lg transition">
        <!-- Product Image -->
        <% if product.image.attached? %>
          <%= link_to product_path(product) do %>
            <%= image_tag product.image.variant(resize_to_fill: [400, 300]), class: "w-full h-48 object-cover rounded-t-lg mb-4", alt: product.title %>
          <% end %>
        <% else %>
          <div class="w-full h-48 bg-gray-200 rounded-t-lg mb-4 flex items-center justify-center">
            <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
        <% end %>

        <!-- Product Details -->
        <h2 class="text-xl font-semibold mb-2">
          <%= link_to product.title, product, class: "hover:text-blue-600" %>
        </h2>

        <% if product.categories.any? %>
          <div class="flex flex-wrap gap-1 mb-2">
            <% product.categories.limit(3).each do |category| %>
              <span class="text-xs px-2 py-1 bg-blue-100 text-blue-700 rounded">
                <%= category.name %>
              </span>
            <% end %>
          </div>
        <% end %>

        <p class="text-gray-600 mb-3 line-clamp-2"><%= product.description %></p>

        <div class="flex justify-between items-center">
          <span class="text-2xl font-bold text-green-600">$<%= number_with_precision(product.price, precision: 2) %></span>
          <%= link_to "View Details", product, class: "btn btn-primary text-sm" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Pagination Navigation -->
  <% if @products.any? %>
    <div class="mt-8">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>

  <% if @products.empty? %>
    <div class="text-center py-12">
      <% if params[:search].present? || params[:min_price].present? || params[:max_price].present? %>
        <p class="text-gray-500 text-lg">No products match your search criteria.</p>
        <%= link_to "Clear filters", products_path, class: "btn btn-primary mt-4" %>
      <% else %>
        <p class="text-gray-500 text-lg">No products available yet.</p>
        <% if user_signed_in? %>
          <%= link_to "Create the first product", new_product_path, class: "btn btn-primary mt-4" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
