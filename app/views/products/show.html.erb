<div class="page-container">
  <!-- Back navigation -->
  <%= link_to products_path, class: "nav-link" do %>
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
    Back to Products
  <% end %>

  <div class="grid md:grid-cols-2 gap-8">
    <!-- Product Image -->
    <div>
      <% if @product.image.attached? %>
        <%= image_tag @product.image, class: "w-full h-auto rounded-lg shadow-lg", alt: @product.title %>
      <% else %>
        <div class="product-image-placeholder rounded-lg">
          <svg class="w-24 h-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
      <% end %>
    </div>

    <!-- Product Details -->
    <div>
      <h1 class="text-4xl font-bold mb-4"><%= @product.title %></h1>

      <div class="mb-6">
        <span class="text-4xl font-bold text-green-600">$<%= sprintf("%.2f", @product.price) %></span>
      </div>

      <div class="mb-6">
        <h2 class="text-lg font-semibold mb-2">Description</h2>
        <p class="text-gray-700 whitespace-pre-line leading-relaxed"><%= @product.description %></p>
      </div>

      <div class="mb-6 pb-6 border-b border-gray-200">
        <p class="text-sm text-gray-600">
          <span class="font-semibold">Seller:</span> <%= @product.user.email %>
        </p>
        <% if @product.digital_file.attached? %>
          <p class="text-sm text-gray-600 mt-2">
            <span class="font-semibold">File:</span>
            <%= @product.digital_file.filename %>
            <span class="text-gray-400">(<%= number_to_human_size(@product.digital_file.byte_size) %>)</span>
          </p>
        <% end %>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-3">
        <% if user_signed_in? && @product.user == current_user %>
          <!-- Owner actions -->
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
            <p class="text-sm text-blue-800 font-semibold mb-3">You own this product</p>
            <div class="flex gap-3">
              <%= link_to "Edit Product", edit_product_path(@product), class: "btn btn-primary flex-1" %>
              <%= button_to "Delete Product", @product, method: :delete, data: { turbo_confirm: "Are you sure? This cannot be undone." }, class: "btn btn-danger flex-1" %>
            </div>
          </div>
        <% elsif user_signed_in? %>
          <!-- Buyer actions -->
          <%= button_to "Add to Cart", add_item_to_cart_path(product_id: @product.id), method: :post, class: "btn btn-success btn-lg w-full" %>
          <%= link_to "Continue Shopping", products_path, class: "btn btn-secondary w-full text-center" %>
        <% else %>
          <!-- Guest actions -->
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <p class="text-sm text-yellow-800 mb-3">Sign in to purchase this product</p>
            <%= link_to "Sign In", new_user_session_path, class: "btn btn-primary w-full" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
