<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Products", products_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <div class="grid md:grid-cols-2 gap-8">
    <!-- Product Image -->
    <div>
      <% if @product.image.attached? %>
        <%= image_tag @product.image, class: "w-full h-auto rounded-lg shadow-lg", alt: @product.title %>
      <% else %>
        <div class="w-full h-96 bg-gray-200 rounded-lg flex items-center justify-center">
          <svg class="w-24 h-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
      <% end %>
    </div>

    <!-- Product Details -->
    <div>
      <h1 class="text-3xl font-bold mb-4"><%= @product.title %></h1>

      <div class="mb-6">
        <span class="text-4xl font-bold text-green-600">$<%= number_with_precision(@product.price, precision: 2) %></span>
      </div>

      <div class="mb-6">
        <h2 class="text-lg font-semibold mb-2">Description</h2>
        <p class="text-gray-700 whitespace-pre-line"><%= @product.description %></p>
      </div>

      <div class="mb-6">
        <p class="text-sm text-gray-600">
          <span class="font-semibold">Seller:</span> <%= @product.user.email %>
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-3">
        <% if user_signed_in? %>
          <%= button_to "Add to Cart", add_item_to_cart_path(product_id: @product.id), method: :post, class: "btn btn-primary w-full" %>
        <% else %>
          <%= link_to "Sign in to Purchase", new_user_session_path, class: "btn btn-primary w-full block text-center" %>
        <% end %>

        <% if user_signed_in? && @product.user == current_user %>
          <div class="flex gap-2 pt-4 border-t">
            <%= link_to "Edit", edit_product_path(@product), class: "btn btn-secondary flex-1" %>
            <%= button_to "Delete", @product, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger flex-1" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
