<%= form_with(model: @product) do |form| %>
  <%= form.label :title %>
  <%= form.text_field :title %>

  <%= form.label :description %>
  <%= form.text_area :description %>

  <%= form.label :price %>
  <%= form.number_field :price, step: 0.01 %>

  <%= form.label :file %>
  <%= form.text_field :file %>

  <%= form.submit %>
<% end %>
