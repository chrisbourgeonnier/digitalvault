<div class="form-container">
  <%= form_with(model: product, class: "space-y-0") do |form| %>
    <% if product.errors.any? %>
      <div class="alert alert-error mb-6">
        <h2 class="font-bold text-lg mb-2">
          <%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:
        </h2>
        <ul class="list-disc list-inside space-y-1">
          <% product.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :title, "Product Title" %>
      <%= form.text_field :title, class: "input", placeholder: "e.g., Premium Business Plan Template" %>
    </div>

    <div class="form-group">
      <%= form.label :description, "Product Description" %>
      <%= form.text_area :description, rows: 6, class: "input", placeholder: "Describe what customers will get..." %>
      <p class="text-xs text-gray-500 mt-1">Provide detailed information about your product</p>
    </div>

    <div class="form-group">
      <%= form.label :price, "Price (USD)" %>
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">$</span>
        <%= form.number_field :price, step: 0.01, min: 0, class: "input pl-8", placeholder: "9.99" %>
      </div>
    </div>

    <div class="form-group">
      <%= form.label :image, "Product Image (optional)" %>
      <%= form.file_field :image, accept: "image/png,image/jpeg,image/jpg,image/gif,image/webp", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer" %>
      <p class="text-xs text-gray-500 mt-1">PNG, JPG, GIF, or WebP - Max 5MB</p>

      <% if product.image.attached? %>
        <div class="mt-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
          <p class="text-sm text-gray-600 mb-2 font-semibold">Current image:</p>
          <%= image_tag product.image, class: "w-32 h-32 object-cover rounded border border-gray-300", alt: "Current product image" %>
        </div>
      <% end %>
    </div>

    <div class="form-group">
      <%= form.label :digital_file, "Digital File" %>
      <%= form.file_field :digital_file, accept: ".pdf,.png,.jpg,.jpeg,.zip,.doc,.docx", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer" %>
      <p class="text-xs text-gray-500 mt-1">PDF, Image, ZIP, or DOC file - This is what customers will download</p>

      <% if product.digital_file.attached? %>
        <div class="mt-3 p-3 bg-green-50 rounded-lg border border-green-200">
          <div class="flex items-center">
            <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <p class="text-sm font-semibold text-green-800">File attached:</p>
              <p class="text-xs text-green-700">
                <%= product.digital_file.filename %>
                (<%= number_to_human_size(product.digital_file.byte_size) %>)
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="form-actions">
      <%= form.submit class: "btn btn-primary btn-lg flex-1" %>
      <%= link_to "Cancel", product.persisted? ? product_path(product) : products_path, class: "btn btn-secondary flex-1 text-center" %>
    </div>
  <% end %>
</div>
